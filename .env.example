# fal.ai API key — get one at https://fal.ai/dashboard/keys
# Format: <uuid>:<secret>
# Local dev: copy this file to .env.local and fill it in.
# Production: set FAL_KEY in your host's environment variables.
FAL_KEY=

# Resend API key — get one at https://resend.com/api-keys
# Used by /api/message to email Yusuf when a visitor leaves a message.
RESEND_API_KEY=
